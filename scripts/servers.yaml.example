# ============================================================
# 3x-ui 服务器列表
# ============================================================

proxy: socks5://127.0.0.1:10808  # or empty for direct

defaults:
  dest: 1.1.1.1:443
  server_names: [www.microsoft.com]
  port: random
  port_range: [10000, 60000]
  fingerprint: chrome

servers:
  - name: server-1
    url: http://<ip>:<port>/<path>
    username: <user>
    password: <pass>
    # 以下为可选 SSH 字段，用于一次性 DB 模板补丁（DNS 防泄露）
    # ssh: root@<ip>:22
    # ssh_key: ~/.ssh/id_rsa   # 或 ssh_key: /path/to/key
    # ssh_pass: ""              # 或用密码（不推荐）
